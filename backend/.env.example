BIND_ADDR=0.0.0.0:8580
DATABASE_URL=sqlite://./happi.db?mode=rwc
# Required to validate Telegram WebApp initData (x-telegram-init-data).
TELEGRAM_BOT_TOKEN=
# OpenAI
# Defaults favor latency over maximum reasoning depth.
# OPENAI_API_KEY=
# HAPPI_CHAT_MODEL=gpt-5-mini
# HAPPI_OBSERVATION_MODEL=gpt-5-mini
# HAPPI_EMBEDDING_MODEL=text-embedding-3-large
# HAPPI_CHAT_REASONING_EFFORT=low
# HAPPI_OBSERVATION_REASONING_EFFORT=low
# HAPPI_CHAT_VERBOSITY=low
# HAPPI_OBSERVATION_VERBOSITY=low
# HAPPI_CHAT_TIMEOUT_MS=15000
# HAPPI_OBSERVATION_TIMEOUT_MS=20000
# If you switch embeddings to `text-embedding-3-small` on an existing DB, rebuild or clear
# the `embeddings` table so semantic search is not mixing vector sizes.
# Optional: in production set the webapp origin, e.g. https://your-webapp-host
# CORS_ALLOW_ORIGIN=

# Stopped mode — set to 1 to keep the bot online but reply to every message with
# a self-host notice instead of running the normal pipeline.
# HAPPI_STOPPED=1

# Telegram webhook (optional)
# Public HTTPS webhook endpoint that Telegram should call, e.g.
# https://happiiiiibot.ammarfaisal.me/telegram/webhook
HOOK_URL=
# If set, `POST /telegram/webhook` requires:
#   X-Telegram-Bot-Api-Secret-Token: <WEBHOOK_SECRET_TOKEN>
WEBHOOK_SECRET_TOKEN=
# If set, the bot will reply to /start with a Web App button pointing here.
MINIAPP_URL=
